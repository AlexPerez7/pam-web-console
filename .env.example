# Copiar a .env y completar. .env NUNCA se commitea (está en .gitignore).

# --- Postgres (lo usa docker-compose y la API) ---
POSTGRES_PASSWORD=cambiar-esto

# --- Modo demo ---
# true = la API de CyberArk la responde un mock con 5 tenants ficticios y no
# se lee el secret store (ver backend/app/demo/). Para probar la consola sin
# un tenant real. NUNCA activarlo contra tenants de verdad.
PAM_DEMO_MODE=false

# --- API ---
# Clave para firmar sesiones/JWT. Generar con: openssl rand -hex 32
PAM_SECRET_KEY=cambiar-esto-openssl-rand-hex-32
PAM_ENVIRONMENT=dev
# Logging: nivel del root y formato (auto|json|console).
# auto -> console en dev, json fuera de dev.
PAM_LOG_LEVEL=INFO
PAM_LOG_FORMAT=auto
# TTL del access token (horas) y del refresh token (días)
PAM_JWT_TTL_HOURS=8
PAM_REFRESH_TTL_DAYS=30
# Anti-fuerza-bruta de /auth/login: N fallos por (usuario, IP) en la ventana
PAM_LOGIN_MAX_FAILS=5
PAM_LOGIN_LOCKOUT_MINUTES=15

# Límites de escritura (Fase 2). Rate-limit por (operador, tenant) y tope de
# objetos que puede tocar una sola operación (circuit breaker).
PAM_WRITE_MAX_PER_WINDOW=30
PAM_WRITE_WINDOW_MINUTES=5
PAM_WRITE_OBJECT_CAP=25

# Concurrencia máxima de requests hacia un mismo tenant de CyberArk
PAM_CYBERARK_MAX_CONCURRENCY=8

# TTL (segundos) del caché en Redis del cálculo del dashboard por tenant
PAM_DASHBOARD_CACHE_TTL=900

# Backups de cuentas borradas (Fase 3, account.delete). La pública del
# keypair de backups — NO es secreta, puede ir acá. Generar con
# `age-keygen` (ver secrets/README.md); la privada va en
# secrets/backups-age.key, nunca en .env.
PAM_BACKUPS_AGE_RECIPIENT=

# Reglas de alerta (Fase 5, docs/specs/done/alert-rules.md) — componente/tenant
# caído, aprobación pendiente sin resolver. Canal v1: webhook de Teams
# (flujo de "Flujos de trabajo"/Power Automate, plantilla "Publicar en un
# canal cuando se reciba una solicitud de webhook"). Sin
# PAM_ALERTS_TEAMS_WEBHOOK_URL, el motor sigue evaluando y auditando,
# sólo no manda el mensaje (ver app/core/notify.py).
# Zona horaria con la que se muestran las ventanas de mantenimiento (default America/Santiago)
# PAM_ALERTS_TIMEZONE=America/Santiago
# URL base de la UI para los links de los avisos (ej. https://pam.lab.local); vacío = sin link
# PAM_ALERTS_UI_BASE_URL=
# Debounce de componente caído (docs/specs/alert-delivery.md): corridas seguidas
# para abrir y corridas limpias seguidas para resolver; 1 = sin debounce
# PAM_ALERTS_CONFIRM_RUNS=2
# PAM_ALERTS_RESOLVE_RUNS=2
PAM_ALERTS_TEAMS_WEBHOOK_URL=

# Canal alternativo por correo (SMTP), opcional.
PAM_ALERTS_SMTP_HOST=
PAM_ALERTS_SMTP_PORT=587
PAM_ALERTS_SMTP_USER=
PAM_ALERTS_SMTP_PASSWORD=
PAM_ALERTS_SMTP_FROM=
PAM_ALERTS_SMTP_USE_TLS=true
# destinatarios separados por coma
PAM_ALERTS_EMAIL_TO=

# db_url / redis_url los inyecta docker-compose apuntando a los servicios internos.
# Para correr la API fuera de compose, descomentar:
# PAM_DB_URL=postgresql+asyncpg://pam:cambiar-esto@localhost:5432/pam
# PAM_REDIS_URL=redis://redis:6379/0

# --- Acceso web (servicio `web` / nginx) ---
# Exposición del HTTPS (:443). 127.0.0.1 = solo túnel SSH (default seguro).
# 0.0.0.0 o la IP LAN = accesible por hostname desde la red del MSP.
PAM_HTTPS_BIND=127.0.0.1
# Hostname del cert self-signed que se autogenera si no hay uno real en ./tls
PAM_HOSTNAME=pam.local
