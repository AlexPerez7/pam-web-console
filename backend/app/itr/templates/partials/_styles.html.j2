:root {
  --primary: #16191c;
  --accent: #5c6368;
  --bg: #f4f6f7;
  --card-bg: #ffffff;
  --border: #d0d4d7;
  --ok: #2e7d54;
  --crit: #c0392b;
  --warn: #b8860b;
  --muted: #7b8085;
  --mono: 'SFMono-Regular', Consolas, monospace;
}
* { box-sizing: border-box; }
body {
  font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
  background: var(--bg);
  margin: 0;
  padding: 0;
  color: var(--primary);
}
header {
  background: linear-gradient(to top right, #020515 0%, #062d53 55%, #75d6f4 100%);
  color: #ffffff;
  padding: 20px 40px 0 40px;
}
.header-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 16px;
}
.header-brand {
  display: flex;
  align-items: center;
  gap: 16px;
}
.brand-logo {
  height: 72px;
  width: auto;
  border-radius: 4px;
  background: white;
  padding: 6px 12px;
}
.client-logo {
  height: 64px;
  width: auto;
  border-radius: 4px;
  background: white;
  padding: 6px 12px;
}
header h1 { margin: 0 0 5px 0; font-size: 19px; font-weight: 600; letter-spacing: -0.01em; }
header h1 .title-acronym { font-size: 13px; font-weight: 400; opacity: 0.7; }
header .sub { font-family: var(--mono); font-size: 11px; color: #8fa3ae; display: flex; gap: 16px; }
.header-actions { display: flex; align-items: center; gap: 14px; margin-top: 2px; }
.btn-pdf {
  border: 1px solid #35505f;
  background: transparent;
  color: #cfe0e7;
  font: inherit;
  font-size: 12px;
  padding: 7px 14px;
  border-radius: 5px;
  cursor: pointer;
}
.btn-pdf:hover { background: rgba(255,255,255,0.06); }

/* ---- Menú hamburguesa mobile (ver @media abajo): en desktop el checkbox
   y el botón quedan ocultos y nav.tabs se ve exactamente igual que antes -
   solo importan a partir de 768px. ---- */
.nav-toggle-checkbox { position: absolute; opacity: 0; pointer-events: none; }
.nav-toggle-btn { display: none; }
.tab-btn-wrap { display: contents; }

nav.tabs {
  display: flex;
  gap: 2px;
  overflow-x: auto;
}
nav.tabs button {
  display: flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: none;
  color: #9fb2bd;
  padding: 10px 16px;
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
  border-radius: 6px 6px 0 0;
  white-space: nowrap;
}
nav.tabs button.active {
  background: var(--bg);
  color: var(--primary);
  font-weight: 600;
}
.tab-badge {
  background: var(--crit);
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  padding: 1px 6px;
  border-radius: 9px;
  line-height: 1.5;
}
main { padding: 24px 40px 60px 40px; }
.tabpanel { display: none; }
.tabpanel.active { display: block; }
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}
.card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 18px 20px;
}
.card h2 {
  font-size: 15px;
  font-weight: 600;
  margin: 0 0 4px 0;
  color: var(--primary);
  padding-bottom: 0;
  border-bottom: none;
}
/* Cards que sí necesitan separar el título del contenido (tablas, listas
   largas) - el resto (charts, KPIs) queda sin regla, más limpio. */
.card > h2:only-of-type:not(:last-child) { margin-bottom: 14px; }
.card .card-subtitle { font-size: 12px; color: var(--muted); margin: 2px 0 16px 0; }
.card h3 {
  font-size: 14px;
  margin: 18px 0 8px 0;
  color: var(--primary);
}
.card h3:first-of-type { margin-top: 0; }
.kpi-row { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 10px; }
.kpi { flex: 1; min-width: 110px; text-align: center; }
.kpi .value { font-family: var(--mono); font-size: 24px; font-weight: 600; color: var(--primary); letter-spacing: -0.01em; }
.kpi .label { font-size: 12px; color: var(--muted); margin-top: 2px; }
.mini-kpi { flex: 1; min-width: 90px; text-align: center; }
.mini-kpi .value { font-family: var(--mono); font-size: 19px; font-weight: 600; color: var(--primary); }
.mini-kpi .label { font-size: 11px; color: var(--muted); }
/* .kpi .value / .mini-kpi .value tienen más especificidad que .ok/.crit/.warn
   solas (dos clases contra una) y les pisarían el color - estas reglas
   igualan la especificidad para que "value ok/crit/warn" sí se vea coloreado. */
.kpi .value.ok, .mini-kpi .value.ok { color: var(--ok); }
.kpi .value.crit, .mini-kpi .value.crit { color: var(--crit); }
.kpi .value.warn, .mini-kpi .value.warn { color: var(--warn); }

/* ---- KPI héroe (Overview): franja de 6 métricas con separadores, en vez
   de tarjetas con gap - imita un panel de instrumentos, es la primera
   card que se lee en el reporte. ---- */
.kpi-hero-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
}
.kpi-hero {
  padding: 16px 20px;
  border-right: 1px solid var(--border);
}
.kpi-hero:last-child { border-right: none; }
.kpi-hero .value { font-family: var(--mono); font-size: 30px; font-weight: 600; letter-spacing: -0.02em; color: var(--primary); line-height: 1.1; }
.kpi-hero .value.ok { color: var(--ok); }
.kpi-hero .value.crit { color: var(--crit); }
.kpi-hero .value.warn { color: var(--warn); }
.kpi-hero .label { font-size: 12px; color: var(--muted); margin-top: 4px; }
.kpi-hero .delta { font-size: 11px; margin-top: 6px; color: var(--muted); }
.kpi-hero .delta.crit { color: var(--crit); }
.kpi-hero .delta-bar { height: 5px; background: var(--bg); border-radius: 3px; margin-top: 8px; overflow: hidden; }
.kpi-hero .delta-bar-fill { height: 5px; }

/* ---- Pestaña Components: mismo panel de KPI héroe, con el texto
   secundario más liviano (mockup aprobado) - scoped a #components para no
   afectar el hero de Overview/Sesiones, que comparten .kpi-hero-row/.kpi-hero.
   El separador entre tarjetas es un ::after "flotante" (no un border-right)
   para que no toque el borde superior/inferior de la fila, como en el mockup. ---- */
#components .kpi-hero-row .kpi-hero { border-right: none; padding: 20px 24px; position: relative; }
#components .kpi-hero-row .kpi-hero:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 22%;
  bottom: 22%;
  right: 0;
  width: 1px;
  background: var(--border);
}
#components .kpi-hero .delta { font-size: 10px; font-weight: 400; }

/* ---- Mismo tratamiento de separador flotante que Components (ver arriba)
   para el resto de las pestañas ya rediseñadas con este patrón - scoped
   (no global) para no tocar el hero de Overview/Sesiones/KPI's todavía. ---- */
#safes .kpi-hero-row .kpi-hero,
#platforms .kpi-hero-row .kpi-hero,
#accounts .kpi-hero-row .kpi-hero,
#kpis .kpi-hero-row .kpi-hero,
#infra .kpi-hero-row .kpi-hero {
  border-right: none;
  position: relative;
}
#safes .kpi-hero-row .kpi-hero:not(:last-child)::after,
#platforms .kpi-hero-row .kpi-hero:not(:last-child)::after,
#accounts .kpi-hero-row .kpi-hero:not(:last-child)::after,
#kpis .kpi-hero-row .kpi-hero:not(:last-child)::after,
#infra .kpi-hero-row .kpi-hero:not(:last-child)::after {
  content: '';
  position: absolute;
  top: 22%;
  bottom: 22%;
  right: 0;
  width: 1px;
  background: var(--border);
}

/* ---- Rótulo de agrupación dentro de un grid (ej. pestaña Sesiones) - más
   peso/tamaño y color oscuro que un simple ".muted" para que se note como
   encabezado de sección, no se pierda con el resto del texto secundario. ---- */
.section-label {
  grid-column: 1 / -1;
  font-family: var(--mono);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--primary);
  margin-top: 4px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--border);
}

table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--border); }
th {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 600;
  background: #eef0f1;
}
tr:nth-child(even) td { background: #fafbfb; }
tr:last-child td { border-bottom: none; }
/* ---- Subencabezado de grupo por host (Connector Management) - ver
   applyHostGroupHeaders en _scripts.html.j2. Va después de la regla de
   striping de arriba para pisarla (misma especificidad, gana por orden). ---- */
tr.host-group-header td {
  background: #f1f5f9;
  color: #64748b;
  font-family: var(--mono);
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 7px 8px;
}
.ok { color: var(--ok); font-weight: 600; }
.crit { color: var(--crit); font-weight: 600; }
.warn { color: var(--warn); font-weight: 600; }
.muted { color: var(--muted); font-style: italic; }
.status-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
.status-dot.ok { background: var(--ok); }
.status-dot.crit { background: var(--crit); }
.status-dot.warn { background: var(--warn); }
.status-dot.muted { background: #c9ced2; }
.bar-bg { background: var(--bg); border-radius: 3px; height: 8px; overflow: hidden; display: inline-block; width: 120px; vertical-align: middle; margin-right: 6px; }
.bar-fill { height: 8px; }
.component-bar-row { display: flex; align-items: flex-start; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
.component-bar-row:last-child { border-bottom: none; }
.component-bar-label { flex: 0 0 170px; font-size: 13px; padding-top: 4px; }
.component-bar-track { flex: 1; display: flex; flex-direction: column; gap: 4px; }
.component-bar-row .bar-bg { width: auto; margin-right: 0; height: 14px; }
.component-bar-row .bar-fill { height: 14px; }
.component-bar-version { font-family: var(--mono); font-size: 11px; color: var(--muted); }
.component-bar-count { flex: 0 0 auto; font-family: var(--mono); font-size: 12.5px; color: var(--muted); padding-top: 4px; }
canvas { max-height: 260px; }
footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px 40px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--border); background: var(--card); }
.footer-left { display: flex; flex-direction: column; gap: 2px; }
.footer-left .footer-title { font-size: 12.5px; font-weight: 700; color: var(--primary); }
.footer-left .footer-subtitle { font-size: 11.5px; color: var(--muted); }
.footer-logo { height: 48px; width: auto; }
ul.findings { font-size: 14px; line-height: 1.8; padding-left: 20px; }
ul.findings li { margin-bottom: 6px; }
.severity-badge { display: inline-block; padding: 3px 10px; border-radius: 5px; font-size: 11.5px; font-weight: 600; white-space: nowrap; }
.severity-badge.badge-crit { background: #fbeceb; color: var(--crit); }
.severity-badge.badge-warn { background: #fbf3e3; color: #8a6110; }
.severity-badge.badge-info { background: #eef1f3; color: var(--accent); }
.severity-badge.badge-ok { background: #e5f0e9; color: var(--ok); }

/* ---- Findings: chips de filtro por severidad ---- */
.finding-chip {
  border: 1px solid transparent;
  background: none;
  font: inherit;
  border-radius: 5px;
  cursor: pointer;
  padding: 6px 8px;
}
.finding-chip:hover { background: var(--bg); }
.finding-chip.active { border-color: var(--accent); background: var(--bg); }

/* ---- Findings: acordeón por categoría ---- */
.finding-category { border: 1px solid var(--border); border-radius: 8px; margin-bottom: 14px; overflow: hidden; }
.finding-category:last-child { margin-bottom: 0; }
.finding-category-summary {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  cursor: pointer;
  font-weight: 600;
  color: var(--primary);
  background: #fafbfc;
  list-style: none;
}
.finding-category-summary::-webkit-details-marker { display: none; }
.finding-category-summary::after {
  content: '\25B8';
  margin-left: auto;
  color: var(--muted);
  transition: transform 0.15s;
}
.finding-category[open] > .finding-category-summary::after { transform: rotate(90deg); }
.finding-category-icon { font-size: 15px; }
.finding-category-title { flex: 1; }
.finding-category-count {
  background: var(--bg);
  color: var(--muted);
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 600;
  padding: 2px 9px;
  border-radius: 10px;
}
.finding-category-body { padding: 14px 16px; border-top: 1px solid #eef1f4; }

/* ---- Findings: tarjeta por hallazgo ---- */
.finding-card {
  border: 1px solid var(--border);
  border-left: 3px solid var(--muted);
  border-radius: 6px;
  padding: 12px 16px;
  margin-bottom: 10px;
}
.finding-card:last-child { margin-bottom: 0; }
.finding-card.sev-crit { border-left-color: var(--crit); }
.finding-card.sev-warn { border-left-color: var(--warn); }
.finding-card.sev-info { border-left-color: var(--accent); }
.finding-headline { font-family: var(--mono); font-size: 20px; font-weight: 600; color: var(--primary); margin: 6px 0 2px 0; }
.finding-text { font-size: 13.5px; color: #4b5157; line-height: 1.5; margin: 0 0 8px 0; }
.finding-recommendation {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  background: var(--bg);
  border-radius: 6px;
  padding: 8px 10px;
  font-size: 12.5px;
  line-height: 1.4;
  color: var(--muted);
  font-weight: 400;
}
.finding-recommendation-icon { flex: 0 0 auto; }

/* ---- Overview: card de hallazgos críticos (barra roja + 2 columnas) ---- */
.finding-callout-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}
.finding-callout-title { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600; color: var(--primary); }
.finding-callout-pills { display: flex; gap: 8px; font-size: 12px; }
.finding-callout-pill { font-weight: 600; padding: 4px 11px; border-radius: 5px; }
.finding-callout-pill.crit { background: #fbeceb; color: #a5312a; }
.finding-callout-pill.warn { background: #fbf3e3; color: #8a6110; }
.finding-callout-pill.info { background: var(--bg); color: #5c6368; }
.finding-callout-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
.finding-callout-item { display: flex; gap: 12px; padding: 12px 4px; border-bottom: 1px solid #f2f4f6; }
.finding-callout-item:last-child { border-bottom: none; }
.finding-callout-bar { width: 3px; border-radius: 2px; flex: 0 0 3px; background: var(--crit); }
.finding-callout-body-title { font-size: 13.5px; font-weight: 600; color: var(--primary); }
.finding-callout-body-cat { font-family: var(--mono); font-size: 11px; color: var(--muted); margin-top: 3px; }
.finding-callout-footer { padding-top: 12px; margin-top: 4px; border-top: 1px solid #eef1f3; font-size: 12.5px; color: var(--muted); }
.tab-link { color: var(--primary); text-decoration: none; cursor: pointer; border-bottom: 1px solid currentColor; }
.tab-link:hover { opacity: 0.7; }

/* ---- Tooltip con contenido rico (ej. link a otra pestaña dentro del texto
   explicativo de un &#9432;) - reemplaza el title= nativo, que no admite HTML. ---- */
.info-tip { position: relative; display: inline-block; cursor: help; }
.info-tip-bubble {
  visibility: hidden; opacity: 0; pointer-events: none;
  position: absolute; z-index: 20; bottom: 125%; left: 50%; transform: translateX(-50%);
  background: var(--primary); color: #fff; text-align: left;
  padding: 8px 10px; border-radius: 6px; font-size: 11.5px; line-height: 1.45;
  width: max-content; max-width: 320px; box-shadow: 0 4px 12px rgba(0,0,0,.18);
  transition: opacity .12s ease;
}
.info-tip:hover .info-tip-bubble, .info-tip:focus .info-tip-bubble, .info-tip:focus-within .info-tip-bubble {
  visibility: visible; opacity: 1; pointer-events: auto;
}
.info-tip-bubble .tab-link { color: #fff; }

/* ---- Overview: listado de antigüedad de contraseñas / legend genérico ---- */
.legend-list { display: flex; flex-direction: column; gap: 10px; }
.legend-row { display: flex; align-items: center; gap: 10px; font-size: 12.5px; color: #4e5459; }
.legend-swatch { width: 9px; height: 9px; border-radius: 2px; flex: 0 0 9px; }
.legend-row .legend-label { flex: 1; }
.legend-row .legend-count { font-family: var(--mono); font-size: 12.5px; color: var(--primary); }
.legend-row.legend-sep { border-top: 1px solid var(--border); margin-top: 2px; padding-top: 10px; }

/* ---- Overview: donut con leyenda al costado ---- */
.donut-with-legend { display: flex; align-items: center; gap: 20px; }
.donut-wrap { flex: 0 0 auto; width: 118px; }
.donut-wrap canvas { max-height: 118px; }

.data-warnings { background: #fbf3e3; border-left: 4px solid var(--warn); color: #6b4c0c; padding: 12px 16px; font-size: 13px; margin-bottom: 20px; border-radius: 4px; }
.data-warnings ul { margin: 6px 0 0 18px; padding: 0; }
.infobox { background: var(--bg); border-left: 3px solid var(--accent); padding: 10px 14px; font-size: 13px; margin-bottom: 14px; border-radius: 4px; }
.table-toolbar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
.table-toolbar-actions { display: flex; gap: 10px; align-items: center; }
.table-search { padding: 6px 10px; border: 1px solid var(--border); border-radius: 5px; font-size: 13px; min-width: 220px; }
.btn-export { background: var(--primary); color: white; border: none; padding: 7px 14px; border-radius: 5px; font-size: 13px; cursor: pointer; white-space: nowrap; flex-shrink: 0; }
.btn-export:hover { opacity: 0.85; }
.table-scroll { max-height: 520px; overflow-y: auto; border: 1px solid var(--border); border-radius: 6px; }
.table-pager { display: flex; align-items: center; justify-content: center; gap: 14px; padding: 10px 0 4px 0; font-size: 13px; color: var(--muted); }
.pager-btn { background: var(--card-bg); border: 1px solid var(--border); color: var(--primary); padding: 5px 12px; border-radius: 5px; font-size: 13px; cursor: pointer; }
.pager-btn:hover:not(:disabled) { background: var(--bg); }
.pager-btn:disabled { opacity: 0.4; cursor: default; }
.pager-info { min-width: 170px; text-align: center; }
table.sortable thead th { position: sticky; top: 0; background: #eef0f1; cursor: pointer; user-select: none; white-space: nowrap; }
table.sortable thead th:hover { color: var(--primary); }
table.sortable thead th::after { content: ''; display: inline-block; width: 0; height: 0; margin-left: 5px; vertical-align: middle; }
table.sortable thead th.sort-asc::after { border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 5px solid var(--primary); }
table.sortable thead th.sort-desc::after { border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid var(--primary); }
details { border: 1px solid var(--border); border-radius: 6px; padding: 8px 12px; margin-bottom: 8px; }
details summary { cursor: pointer; font-weight: 600; color: var(--primary); }
details table { margin-top: 10px; }
.legend { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; font-size: 12px; }
.legend-item { padding: 4px 10px; border-radius: 4px; }
/* ": td" para igualar la especificidad de "tr:nth-child(even) td" (más
   arriba) - sin esto, el striping de filas pares pisaba el color semántico
   de estas filas (recency, agrupado por host) en cada segunda fila. */
tr.row-recent td { background: #d9f2df; }
tr.row-stale td { background: #fff3cd; }
tr.row-month td { background: #fde2c8; }
tr.row-old td { background: #f8d7da; }
tr.row-never td { background: #f5b7bb; }
.legend-item.row-recent { background: #d9f2df; }
.legend-item.row-stale { background: #fff3cd; }
.legend-item.row-month { background: #fde2c8; }
.legend-item.row-old { background: #f8d7da; }
.legend-item.row-never { background: #f5b7bb; }
.gauge-value { text-align: center; font-family: var(--mono); font-size: 22px; font-weight: 600; color: var(--primary); margin-top: -70px; margin-bottom: 30px; }
.gauge-value.ok { color: var(--ok); }
.gauge-value.warn { color: var(--warn); }
.gauge-value.crit { color: var(--crit); }

/* ---- Botón "Exportar PDF" (window.print()): sin esto, imprimir solo
   sacaba la pestaña activa en pantalla - se fuerzan todas visibles y se
   ocultan nav/buscadores/paginadores, que no tienen sentido en papel. ---- */
@media print {
  nav.tabs, .header-actions, .table-toolbar-actions, .table-pager, .finding-chip { display: none !important; }
  .tabpanel { display: block !important; page-break-after: always; }
  .table-scroll { max-height: none; overflow: visible; }
}

/* ---- Mobile: el reporte se comparte como archivo HTML suelto y se abre
   donde el cliente esté, teléfono incluido - todo lo de abajo es CSS puro
   (sin JS nuevo, salvo las 2 líneas en _scripts.html.j2 que cierran el
   menú hamburguesa al elegir pestaña) para que no dependa de nada más que
   el navegador. ---- */
@media (max-width: 768px) {
  header { position: relative; padding: 14px 16px 0 16px; }
  .header-top { flex-wrap: wrap; row-gap: 10px; }
  .brand-logo { height: 44px; padding: 4px 8px; }
  .client-logo { height: 40px; padding: 4px 8px; }
  header h1 { font-size: 15px; }
  header .sub { flex-wrap: wrap; row-gap: 4px; font-size: 10px; }
  main { padding: 16px 16px 40px 16px; }

  /* ---- Menú hamburguesa: nav.tabs pasa de barra horizontal a dropdown
     vertical anclado bajo el header, controlado por el checkbox oculto
     (#nav-toggle, ver _header.html.j2). ---- */
  .nav-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    cursor: pointer;
    border-radius: 5px;
  }
  .nav-toggle-btn:hover { background: rgba(255,255,255,0.06); }
  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    display: block;
    width: 20px;
    height: 2px;
    background: #cfe0e7;
    border-radius: 2px;
    transition: transform .15s ease, opacity .15s ease, background .15s ease;
  }
  .nav-toggle-icon { position: relative; }
  .nav-toggle-icon::before, .nav-toggle-icon::after { content: ''; position: absolute; left: 0; }
  .nav-toggle-icon::before { top: -6px; }
  .nav-toggle-icon::after { top: 6px; }
  /* Icono ☰ se transforma en ✕ cuando el menú está abierto. */
  .nav-toggle-checkbox:checked ~ .header-top .nav-toggle-icon { background: transparent; }
  .nav-toggle-checkbox:checked ~ .header-top .nav-toggle-icon::before { transform: translateY(6px) rotate(45deg); }
  .nav-toggle-checkbox:checked ~ .header-top .nav-toggle-icon::after { transform: translateY(-6px) rotate(-45deg); }
  /* El checkbox real sigue siendo foco-able por teclado (Tab + Espacio)
     aunque esté invisible - sin esto un usuario de teclado no tenía forma
     de saber que el botón hamburguesa está enfocado. */
  .nav-toggle-checkbox:focus-visible ~ .header-top .nav-toggle-btn {
    outline: 2px solid #75d6f4;
    outline-offset: 2px;
  }

  .tab-btn-wrap { display: block; width: 100%; }
  nav.tabs {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--primary);
    border-top: 1px solid #2a3138;
    box-shadow: 0 8px 16px rgba(0,0,0,.25);
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    z-index: 30;
    gap: 0;
  }
  .nav-toggle-checkbox:checked ~ nav.tabs { display: flex; }
  nav.tabs button {
    width: 100%;
    justify-content: flex-start;
    padding: 14px 20px;
    border-radius: 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    font-size: 14px;
  }
  nav.tabs button.active { background: rgba(255,255,255,0.08); color: #fff; }

  /* Los grids de contenido traen grid-template-columns por inline style
     (1fr 1fr, repeat(3,1fr), 1.4fr 1fr 1fr, etc.) para el layout de escritorio
     - se pisan todos a una columna sin tocar cada template uno por uno.
     minmax(0,1fr) y no "1fr" a secas: un track "1fr" solo trae un mínimo
     automático basado en el contenido (min-content) de los items - con
     cards que tienen tablas o filas flex adentro, ese mínimo terminaba
     siendo más ancho que el viewport y desbordaba la página. */
  .grid { grid-template-columns: minmax(0, 1fr) !important; }
  .kpi-hero-row { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); }
  .kpi-hero { padding: 14px 16px; }
  .kpi-hero .value { font-size: 24px; }

  /* Sin esto, una card con una tabla ancha adentro no se achica al viewport:
     los ítems de grid/flex tienen min-width:auto por default (no se encogen
     más allá del contenido mínimo de sus hijos), así que la card entera
     crecía para darle lugar a la tabla en vez de dejar que el scroll
     horizontal de abajo hiciera el trabajo. */
  .card, .table-scroll, .table-toolbar, .table-toolbar-actions { min-width: 0; }

  /* Tablas anchas: el <table> pasa a ser el contenedor con scroll horizontal
     (el navegador arma una tabla anónima adentro y preserva alineación de
     columnas) - no hace falta envolver cada tabla en un div nuevo. Los que
     ya viven en .table-scroll (buscador/orden/paginado) se dejan como table
     normal y el scroll horizontal lo maneja ese contenedor, para no romper
     el sticky header de "th". */
  table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .table-scroll { overflow-x: auto; }
  .table-scroll table { display: table; }
  /* Sin esto, una columna angosta (ej. "Tipo") al lado de una con texto
     largo que sí puede wrappear (ej. emails) queda apretada a una letra
     por línea en vez de dejar que la tabla entera scrollee horizontal. */
  th, td { min-width: 64px; }

  .table-toolbar { flex-direction: column; align-items: stretch; }
  .table-search { width: 100%; min-width: 0; }
  .table-pager { flex-wrap: wrap; }
  .pager-info { min-width: 0; }

  .donut-with-legend { flex-direction: column; align-items: flex-start; }
  footer { flex-wrap: wrap; justify-content: center; text-align: center; padding: 16px; }
}

@media (max-width: 480px) {
  /* A este ancho el piso de minmax(280px,1fr) de este grid ya no entra
     entero en un viewport de 320px y desborda - se fuerza una sola columna.
     (.kpi-hero-row no entra acá: su piso de 130px sí cabe de a 2 en 320px,
     forzarla a 1 columna solo la hacía ocupar más alto sin necesidad). */
  .finding-callout-grid { grid-template-columns: minmax(0, 1fr) !important; }

  /* align-items:stretch (no el flex-start heredado, pensado para la fila
     original) - si no, .component-bar-track queda con ancho 0 al pasar a
     columna y la barra de progreso desaparece. */
  .component-bar-row { flex-direction: column; align-items: stretch; gap: 6px; }
  .component-bar-label { flex: none; width: 100%; }
  .component-bar-track { width: 100%; }
}
