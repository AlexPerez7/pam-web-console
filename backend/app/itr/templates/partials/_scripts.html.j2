  // ---- Findings: chips de resumen filtran las tarjetas por severidad ----
  // data-filter-severity="" (chip "Total") limpia el filtro. Clic sobre el
  // chip activo lo desactiva (toggle); clic sobre otro chip lo reemplaza.
  (function () {
    const chips = document.querySelectorAll('.finding-chip');
    const cards = document.querySelectorAll('.finding-card');
    const categories = document.querySelectorAll('.finding-category');

    function applyFilter(severity) {
      cards.forEach(card => {
        card.style.display = (!severity || card.dataset.severity === severity) ? '' : 'none';
      });
      categories.forEach(cat => {
        const anyVisible = Array.from(cat.querySelectorAll('.finding-card'))
          .some(card => card.style.display !== 'none');
        cat.style.display = anyVisible ? '' : 'none';
      });
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const severity = chip.dataset.filterSeverity;
        const alreadyActive = chip.classList.contains('active');
        chips.forEach(c => c.classList.remove('active'));
        if (!severity || alreadyActive) {
          document.querySelector('.finding-chip[data-filter-severity=""]').classList.add('active');
          applyFilter(null);
        } else {
          chip.classList.add('active');
          applyFilter(severity);
        }
      });
    });
  })();

  // ---- Tabla interactiva: orden por columna + búsqueda + paginación + export CSV ----
  // Todas las filas siguen viviendo en el DOM (para que sort/búsqueda/export
  // sigan operando sobre el dataset completo), pero solo se muestran
  // PAGE_SIZE por vez - en tenants con miles de cuentas/miembros de Safe
  // evita que el navegador tenga que pintar/reflow miles de <tr> de golpe.
  const TABLE_PAGE_SIZE = 100;

  // Agrupado por Host Name vía fila de subencabezado (Connector Management,
  // tablas de Infraestructura): el host ya no es una columna de la tabla,
  // así que se lee de data-host en vez de una celda. Se recalcula sobre las
  // filas VISIBLES en el DOM en cada render (después de ordenar/buscar/
  // paginar), así que los subencabezados quedan bien ubicados sin importar
  // cómo esté ordenada la tabla en ese momento.
  function applyHostGroupHeaders(tableId) {
    const table = document.getElementById(tableId);
    if (!table) return;
    const tbody = table.querySelector('tbody');
    tbody.querySelectorAll('tr.host-group-header').forEach(tr => tr.remove());
    const colCount = table.querySelectorAll('thead th').length;
    const dataRows = Array.from(tbody.querySelectorAll('tr:not(.host-group-header)'))
      .filter(row => row.style.display !== 'none' && row.dataset.host !== undefined);
    let prevHost = null;
    dataRows.forEach(row => {
      const host = row.dataset.host || '';
      if (host !== prevHost) {
        const headerRow = document.createElement('tr');
        headerRow.className = 'host-group-header';
        const td = document.createElement('td');
        td.colSpan = colCount;
        td.textContent = host;
        headerRow.appendChild(td);
        tbody.insertBefore(headerRow, row);
        prevHost = host;
      }
    });
  }

  // Las columnas de fecha se muestran como "DD-MM-AAAA" o "DD-MM-AAAA HH:MM"
  // (ej. Created Time, Last Logon, LastLogin, Vence el) - ordenarlas como
  // texto (localeCompare) NO da orden cronológico porque el día va primero,
  // no el año. data-type="date" usa esto para parsear a epoch antes de
  // comparar. Texto que no matchea (ej. "Nunca", "No disponible", "-")
  // cae a -Infinity, igual que un número no parseable en data-type="num".
  function parseDdMmYyyy(text) {
    const m = text.match(/^(\d{2})-(\d{2})-(\d{4})(?:\s+(\d{2}):(\d{2}))?/);
    if (!m) return -Infinity;
    const [, d, mo, y, h, mi] = m;
    return new Date(Number(y), Number(mo) - 1, Number(d), Number(h || 0), Number(mi || 0)).getTime();
  }

  function makeTableInteractive(tableId, searchInputId, exportBtnId, exportFileName, pageSize = TABLE_PAGE_SIZE, onRender = null) {
    const table = document.getElementById(tableId);
    if (!table) return;
    const tbody = table.querySelector('tbody');
    const headers = table.querySelectorAll('thead th');
    let allRows = Array.from(tbody.querySelectorAll('tr'));
    let currentPage = 1;

    const scrollDiv = table.closest('.table-scroll') || table;
    const pager = document.createElement('div');
    pager.className = 'table-pager';
    pager.innerHTML = '<button type="button" class="pager-btn" data-dir="prev">&larr; Anterior</button>'
      + '<span class="pager-info"></span>'
      + '<button type="button" class="pager-btn" data-dir="next">Siguiente &rarr;</button>';
    scrollDiv.insertAdjacentElement('afterend', pager);
    const pagerInfo = pager.querySelector('.pager-info');
    const prevBtn = pager.querySelector('[data-dir="prev"]');
    const nextBtn = pager.querySelector('[data-dir="next"]');

    function matchingRows() {
      const term = (searchInput ? searchInput.value.trim().toLowerCase() : '');
      if (!term) return allRows;
      // dataset.host cubre Connector Management, donde el host ya no es una
      // columna visible (ver applyHostGroupHeaders) pero el buscador "por
      // host" del placeholder tiene que seguir funcionando igual.
      return allRows.filter(row =>
        row.innerText.toLowerCase().includes(term) ||
        (row.dataset.host || '').toLowerCase().includes(term)
      );
    }

    function render() {
      const matched = matchingRows();
      const totalPages = Math.max(1, Math.ceil(matched.length / pageSize));
      currentPage = Math.min(Math.max(currentPage, 1), totalPages);
      const start = (currentPage - 1) * pageSize;
      const pageRows = new Set(matched.slice(start, start + pageSize));

      allRows.forEach(row => { row.style.display = pageRows.has(row) ? '' : 'none'; });

      pagerInfo.textContent = matched.length === 0
        ? 'Sin resultados'
        : `Página ${currentPage} de ${totalPages} (${matched.length} filas)`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
      if (onRender) onRender();
    }

    prevBtn.addEventListener('click', () => { currentPage -= 1; render(); });
    nextBtn.addEventListener('click', () => { currentPage += 1; render(); });

    headers.forEach((th, colIndex) => {
      th.addEventListener('click', () => {
        const type = th.dataset.type || 'text';
        const currentlyAsc = th.classList.contains('sort-asc');
        headers.forEach(h => h.classList.remove('sort-asc', 'sort-desc'));
        const asc = !currentlyAsc;
        th.classList.add(asc ? 'sort-asc' : 'sort-desc');

        function compareCol(a, b) {
          let av = a.children[colIndex].innerText.trim();
          let bv = b.children[colIndex].innerText.trim();
          if (type === 'num') {
            av = parseFloat(av.replace(',', '.')) || -Infinity;
            bv = parseFloat(bv.replace(',', '.')) || -Infinity;
            return asc ? av - bv : bv - av;
          }
          if (type === 'date') {
            av = parseDdMmYyyy(av);
            bv = parseDdMmYyyy(bv);
            return asc ? av - bv : bv - av;
          }
          return asc ? av.localeCompare(bv) : bv.localeCompare(av);
        }

        // Tablas con subencabezado de grupo (data-host, ver
        // applyHostGroupHeaders): el host manda como criterio de orden
        // principal SIEMPRE, y la columna clickeada ordena solo DENTRO de
        // cada grupo - si no, ordenar por Componente/CPU/etc. mezclaba
        // filas de hosts distintos y el agrupado quedaba con un
        // subencabezado casi por fila.
        const grouped = allRows.some(r => r.dataset.host !== undefined);
        allRows.sort((a, b) => {
          if (grouped) {
            const ha = a.dataset.host || '';
            const hb = b.dataset.host || '';
            if (ha !== hb) return ha.localeCompare(hb);
          }
          return compareCol(a, b);
        });
        allRows.forEach(r => tbody.appendChild(r));
        currentPage = 1;
        render();
      });
    });

    const searchInput = document.getElementById(searchInputId);
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentPage = 1;
        render();
      });
    }

    // Neutraliza CSV/formula injection: si una celda empieza con =, +, -, @,
    // tab o CR (caracteres que Excel/Sheets interpretan como inicio de
    // fórmula), se le antepone un apóstrofe para que quede como texto plano.
    function csvCell(text) {
      let v = text;
      if (/^[=+\-@\t\r]/.test(v)) {
        v = "'" + v;
      }
      return '"' + v.replace(/"/g, '""') + '"';
    }

    const exportBtn = document.getElementById(exportBtnId);
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        // Exporta TODAS las filas que matchean la búsqueda, no solo la
        // página actual - la paginación es solo una ayuda de renderizado.
        // Si la tabla trae data-host (Connector Management), el host se
        // agrega como primera columna del CSV aunque ya no se muestre como
        // columna en pantalla (ver applyHostGroupHeaders) - si no, se
        // perdía ese dato al exportar.
        const hasHost = allRows.some(row => row.dataset.host !== undefined);
        const headerLabels = (hasHost ? [csvCell('Host')] : []).concat(
          Array.from(headers).map(h => csvCell(h.innerText))
        );
        const csvRows = matchingRows().map(row => {
          const cells = Array.from(row.children).map(td => csvCell(td.innerText));
          return (hasHost ? [csvCell(row.dataset.host || '')] : []).concat(cells).join(',');
        });
        const csv = [headerLabels.join(',')].concat(csvRows).join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = exportFileName;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    render();
  }

  makeTableInteractive('platformsTable', 'platformsSearch', 'platformsExportBtn', 'platforms.csv');
  makeTableInteractive('safesTable', 'safesSearch', 'safesExportBtn', 'safes.csv');
  makeTableInteractive('membersTable', 'membersSearch', 'membersExportBtn', 'safe_members.csv');
  makeTableInteractive('compliancePlatformTable', 'compliancePlatformSearch', 'compliancePlatformExportBtn', 'compliance_by_platform.csv');
  makeTableInteractive('activeComponentsTable', 'activeComponentsSearch', 'activeComponentsExportBtn', 'active_components.csv');
  makeTableInteractive('connectorsTable', 'connectorsSearch', 'connectorsExportBtn', 'connectors.csv', TABLE_PAGE_SIZE, () => applyHostGroupHeaders('connectorsTable'));
  makeTableInteractive('siaConnectorsTable', 'siaConnectorsSearch', 'siaConnectorsExportBtn', 'sia_connectors.csv');
  makeTableInteractive('accountsTable', 'accountsSearch', 'accountsExportBtn', 'accounts.csv');
  makeTableInteractive('overviewAccountsTable', 'overviewAccountsSearch', 'overviewAccountsExportBtn', 'accounts.csv');
  makeTableInteractive('usersTable', 'usersSearch', 'usersExportBtn', 'users.csv');
  makeTableInteractive('licenseUsersTable', 'licenseUsersSearch', 'licenseUsersExportBtn', 'license_users.csv');
  makeTableInteractive('infraServicesTable', 'infraServicesSearch', 'infraServicesExportBtn', 'infra_services.csv', TABLE_PAGE_SIZE, () => applyHostGroupHeaders('infraServicesTable'));
  makeTableInteractive('infraDisksTable', 'infraDisksSearch', 'infraDisksExportBtn', 'infra_disks.csv', TABLE_PAGE_SIZE, () => applyHostGroupHeaders('infraDisksTable'));
  makeTableInteractive('infraCertsTable', 'infraCertsSearch', 'infraCertsExportBtn', 'infra_rdp_certs.csv', TABLE_PAGE_SIZE, () => applyHostGroupHeaders('infraCertsTable'));
  makeTableInteractive('activityTable', 'activitySearch', 'activityExportBtn', 'account_activity.csv');
  makeTableInteractive('offHoursTable', 'offHoursSearch', 'offHoursExportBtn', 'sesiones_fuera_de_horario.csv');
