  // ---- Tabs ----
  function activateTab(tabId) {
    const btn = document.querySelector('.tab-btn[data-tab="' + tabId + '"]');
    const panel = document.getElementById(tabId);
    if (!btn || !panel) return;
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tabpanel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    panel.classList.add('active');
  }
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      activateTab(btn.dataset.tab);
      // Cierra el menú hamburguesa mobile al elegir una pestaña - el truco
      // CSS de label+checkbox no alcanza a hacerlo solo porque el click cae
      // en el <button> anidado, no en el <label>, y el navegador no lo
      // reenvía al checkbox asociado (ver nav-toggle en _header.html.j2).
      const navToggle = document.getElementById('nav-toggle');
      if (navToggle) navToggle.checked = false;
    });
  });
  // Enlaces internos (ej. "ver pestaña Hallazgos", "ver pestaña KPI's" dentro
  // de un tooltip) que saltan a otra pestaña, o hacen scroll a una sección
  // puntual si el destino está en la misma pestaña ya activa.
  function jumpTo(targetId) {
    const el = document.getElementById(targetId);
    if (!el) return;
    const panel = el.closest('.tabpanel');
    if (panel && !panel.classList.contains('active')) activateTab(panel.id);
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  document.querySelectorAll('.tab-link[data-jump-target]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      jumpTo(link.dataset.jumpTarget);
    });
  });

